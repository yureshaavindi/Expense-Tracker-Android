<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily Summary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1E3A5F"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvSummaryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textSize="15sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Income Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Income"
                android:textSize="16sp"
                android:textColor="#64748B"/>

            <TextView
                android:id="@+id/tvTotalIncome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rs. 0.00"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#15803D"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Expense Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Expenses"
                android:textSize="16sp"
                android:textColor="#64748B"/>

            <TextView
                android:id="@+id/tvTotalExpenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rs. 0.00"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#DC2626"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Balance Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Balance"
                android:textSize="16sp"
                android:textColor="#64748B"/>

            <TextView
                android:id="@+id/tvDailyBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rs. 0.00"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1E3A5F"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Transaction Count Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Transactions"
                android:textSize="16sp"
                android:textColor="#64748B"/>

            <TextView
                android:id="@+id/tvTransactionCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1E3A5F"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Category Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="3dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category Details"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1E3A5F"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/layoutCategoryDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>

        <Button
        android:id="@+id/btnBackHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back To Home"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2563EB"
        android:padding="14dp"/>

        <Button
            android:id="@+id/btnViewExpenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Expenses"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:padding="14dp"/>

    </LinearLayout>
</ScrollView>
